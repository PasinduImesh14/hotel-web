version: "3.9"
services:
  nextjs:
    image: mhartvishwajith448/travel-nextjs:latest
    container_name: travel_nextjs
    ports:
      - "3001:3000"   # host 3001 → container 3000
    environment:
      - DATABASE_URL=mysql://root:2Vishwajith@db:3306/hotel_db
      - ADMIN_API_SECRET=MY_SUPER_SECRET
      - NEXT_PRIVATE_TURBOPACK=0
      - EMAIL_HOST=smtp.gmail.com
      - EMAIL_PORT=587
      - EMAIL_USER=sceniccottagesigiriya@gmail.com
      - EMAIL_PASSWORD=xvntrmqvexegbjdi
      - ADMIN_EMAIL=sceniccottagesigiriya@gmail.com 
    depends_on:
      - db
    restart: unless-stopped
    healthcheck:
     test: ["CMD-SHELL", "curl -f http://127.0.0.1:3000/favicon.ico || exit 1"]
     interval: 30s
     timeout: 30s
     retries: 5
     start_period: 60s


  db:
    image: mysql:8.0
    container_name: travel_mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: 2Vishwajith
      MYSQL_DATABASE: hotel_db
    ports:
      - "3307:3306"   # host 3307 → container 3306
    volumes:
      - mysql_data:/var/lib/mysql

volumes:
  mysql_data:

